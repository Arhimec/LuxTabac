{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/orders",
      "dest": "/api/orders.js"
    },
    {
      "src": "/api/orders/(.*)",
      "dest": "/api/orders.js"
    },
    {
      "src": "/api/quota",
      "dest": "/api/quota.js"
    },
    {
      "src": "/api/quota/(.*)",
      "dest": "/api/quota.js"
    },
    {
      "src": "/api/admin",
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/admin/(.*)",
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/settings",
      "dest": "/api/settings.js"
    },
    {
      "src": "/api/settings/(.*)",
      "dest": "/api/settings.js"
    },
    {
      "src": "/api/coffee-promos",
      "dest": "/api/coffee-promos.js"
    },
    {
      "src": "/api/coffee-promos/(.*)",
      "dest": "/api/coffee-promos.js"
    },
    {
      "src": "/api/custom-items",
      "dest": "/api/custom-items.js"
    },
    {
      "src": "/api/custom-items/(.*)",
      "dest": "/api/custom-items.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
