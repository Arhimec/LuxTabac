{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/orders",
      "dest": "/api/orders.js"
    },
    {
      "src": "/api/orders/(.*)",
      "dest": "/api/orders.js"
    },
    {
      "src": "/api/quota",
      "dest": "/api/quota.js"
    },
    {
      "src": "/api/quota/(.*)",
      "dest": "/api/quota.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
