# ==============================================================================
# LUXTABAC RESERVE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Configure these variables in GitHub Repository Variables / Secrets:
# GitHub -> Settings -> Secrets and variables -> Actions / Repository Variables
# Or set them in your deployment platform (Vercel, Docker, etc.)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MERCHANT PAYMENT & DISPATCH PARAMETERS (Bolt 009)
# ------------------------------------------------------------------------------

# Revolut Recipient @Revtag (without the @ symbol)
# Used for instant ISO/IEC 18004 QR generation and revolut.me direct payment links.
REVOLUT_REVTAG=vladimtul

# WhatsApp Courier Contact Number (with international country code)
# Automatically formatted into https://wa.me/<digits> for order manifest dispatch.
WHATSAPP_NUMBER=+352 691 000 000

# Alternatively, specify a full custom WhatsApp chat URL or Group Invite Link:
# WHATSAPP_LINK=https://chat.whatsapp.com/ExampleGroupInviteCode

# Wero Instant Payment Recipient (EPI - European Payments Initiative)
# Recipient mobile number, email handle, or official Wero payment URI.
WERO_RECIPIENT=+352 691 000 000

# ------------------------------------------------------------------------------
# 2. STORE BACK-OFFICE & ADMINISTRATIVE AUTHENTICATION
# ------------------------------------------------------------------------------

# Admin portal login username (Default: admin)
ADMIN_USER=admin

# Admin portal login password (Default: luxtabac2026!)
ADMIN_PASSWORD=luxtabac2026!
